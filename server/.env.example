# Copy to server/.env and fill in only what you need. This file is git-ignored.

# Login. Required when HOST is not localhost. 8+ characters. Optional on your own computer.
# APP_PASSWORD=
# TRUST_PROXY=1             # set when hosted behind Render/Railway/Fly so https is detected

# Server
# PORT=3000
# HOST=127.0.0.1            # use 0.0.0.0 only when hosting, and add authentication first
# ALLOWED_HOSTS=localhost   # comma-separated host names the server answers to when hosting
# DB_FILE=./data/daypilot.db
# SEED_SAMPLE_DATA=0        # set 0 to skip the sample data on first run

# Web push (generate with: npm run vapid -w server)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# SMS and phone calls via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
