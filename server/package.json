{
  "name": "daypilot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed-cli.js",
    "vapid": "node --input-type=module -e \"import w from 'web-push'; console.log(w.generateVAPIDKeys())\"",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  }
}
